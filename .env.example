# Crie um projeto em https://supabase.com e copie estas chaves em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Chave de serviço (nunca exponha no client) - usada só em rotas server-side/admin
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# E-mail transacional (https://resend.com) - opcional em dev: se não tiver a
# chave, os avisos de cadastro/aprovação/lead só são logados no console.
RESEND_API_KEY=
EMAIL_FROM="Barba&Cia <contato@seudominio.com>"
